# Copy to .env.local (gitignored) and fill in. Read by the server only (server/api.ts via vite.config.ts).
# Never put a real token in this file: it is committed.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
# Optional, these are the defaults:
AIRTABLE_LEADS_TABLE=Leads
AIRTABLE_ACTIVITIES_TABLE=Activities
AIRTABLE_OWNERS_TABLE=Owners
AIRTABLE_TASKS_TABLE=Tasks
